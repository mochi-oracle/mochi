#!/bin/sh
set -eu
remote_name=${1:-}
remote_url=${2:-}
case "$remote_url" in
  https://github.com/mochi-oracle/mochi|https://github.com/mochi-oracle/mochi.git) ;;
  *) echo 'identity-guard: push remote must be https://github.com/mochi-oracle/mochi.git' >&2; exit 1 ;;
esac
case "$remote_name" in
  origin) ;;
  *) echo 'identity-guard: use the origin public remote' >&2; exit 1 ;;
esac
if [ "${MOCHI_PUBLISH_WRAPPER:-}" != 1 ]; then
  echo 'identity-guard: push through scripts/publish-public.ts so the verified credential is pinned for transport' >&2
  exit 1
fi
if [ -z "${MOCHI_PUSH_TOKEN:-}" ]; then
  echo 'identity-guard: verified publisher transport is required' >&2
  exit 1
fi
root=$(git rev-parse --show-toplevel)
cd "$root"
expected_login=$(git config --local --get mochi.publisherLogin)
expected_id=$(git config --local --get mochi.publisherId)
actor=$(GH_TOKEN="$MOCHI_PUSH_TOKEN" GITHUB_TOKEN="$MOCHI_PUSH_TOKEN" gh api user --jq '[.login, (.id|tostring)] | join(":")')
if [ "$actor" != "$expected_login:$expected_id" ]; then
  echo 'identity-guard: authenticated publisher does not match local approval' >&2
  exit 1
fi
bun scripts/identity-guard.ts --mode all
bun scripts/identity-guard.ts --mode history

# Reject branch deletions and non-fast-forward updates from this hook as an extra safeguard.
count=0
while read -r local_ref local_oid remote_ref remote_oid; do
  count=$((count + 1))
  if [ "$count" -gt 1 ]; then echo 'identity-guard: one explicit branch ref is allowed per push' >&2; exit 1; fi
  case "$local_ref:$remote_ref" in refs/heads/*:refs/heads/*) ;; *) echo 'identity-guard: only a branch ref may be pushed' >&2; exit 1 ;; esac
  case "$local_oid" in ''|0000000000000000000000000000000000000000) echo 'identity-guard: deleting refs is blocked' >&2; exit 1 ;; esac
  if [ "$remote_oid" != 0000000000000000000000000000000000000000 ]; then
    if ! git merge-base --is-ancestor "$remote_oid" "$local_oid"; then
      echo 'identity-guard: non-fast-forward update is blocked' >&2
      exit 1
    fi
  fi
done
if [ "$count" -ne 1 ]; then echo 'identity-guard: expected one branch ref update' >&2; exit 1; fi
