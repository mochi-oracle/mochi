MOCHI_DEPLOYMENT=/app/deployments/mainnet.json
DATABASE_URL=<REQUIRED_PRIVATE_DATABASE_URL>
INTAKE_URL=<PRIVATE_INTAKE_BASE_URL>
RELAYER_KEY=<SECRET_FROM_ENCRYPTED_STORE>
RELAY_RATE_LIMIT_CAPACITY=20
RELAY_RATE_LIMIT_REFILL_PER_SECOND=0.5
RELAY_BODY_LIMIT_BYTES=1048576
ANONYMA_HMAC_SECRET=<SECRET_FROM_ENCRYPTED_STORE>
MCP_VOUCHER_MODE=false
INTERNAL_PAYERS=<REVIEWED_ALLOWLIST>
PORT=8080
