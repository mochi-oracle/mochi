# Semgrep exclusions (CI: the `semgrep` job in .github/workflows/security.yml). A .semgrepignore replaces Semgrep's
# built-in defaults, so the relevant defaults are repeated here. Untracked and .gitignore'd files are never scanned.
:include .gitignore
.git/
node_modules/
dist/
build/
*.min.js

